# Copy this file to `keystore.properties` (same folder) and fill in your real
# values. `keystore.properties` is gitignored on purpose — never commit it,
# never paste its contents anywhere public.
#
# storeFile is relative to the android/ folder. The example below assumes the
# .jks file sits right next to this one (android/controlfrete-release.jks).

storeFile=controlfrete-release.jks
storePassword=CHANGE_ME
keyAlias=controlfrete
keyPassword=CHANGE_ME
